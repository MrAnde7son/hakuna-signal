# User-Agent sent on all outbound HTTP requests (Reddit, Spiceworks, Tenable, PeerSpot, G2)
HAKUNA_SIGNAL_USER_AGENT=hakuna-signal/1.0

# GCP (uses gcloud auth application-default credentials)
GCP_PROJECT=hakuna-prod-2026
GCP_REGION=us-east5

# Run interval in minutes (default: 30)
RUN_INTERVAL_MINUTES=30

# Minimum relevance score to send alert (default: 7)
MIN_RELEVANCE_SCORE=7

# Cloudflare API token (Zone:DNS:Edit on hakunahq.com) for Terraform DNS management.
CLOUDFLARE_API_TOKEN=
